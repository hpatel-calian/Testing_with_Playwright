# Copy to .env (git-ignored) and fill in. Real environment variables / CI secrets override these.
# Leave a value empty to use the default in config/env.ts (the public OrangeHRM demo).

# App under test, e.g. a self-hosted instance: http://localhost:8080
BASE_URL=
# REST API root; defaults to ${BASE_URL}/web/index.php/api/v2/
API_URL=
# Environment name shown in reports
TEST_ENV=

# Admin credentials (never commit real ones)
ADMIN_USERNAME=
ADMIN_PASSWORD=
