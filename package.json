{
  "name": "testing_with_playwright",
  "version": "1.0.0",
  "description": "End-to-end tests using [Playwright](https://playwright.dev).",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test tests/e2e",
    "test:integration": "playwright test tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p .",
    "check:tags": "node scripts/check-jira-tags.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpatel-calian/Testing_with_Playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hpatel-calian/Testing_with_Playwright/issues"
  },
  "homepage": "https://github.com/hpatel-calian/Testing_with_Playwright#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
